# TaskFlow Agent Environment Variables
# Copy this to .env and fill in your values

# Required
ANTHROPIC_API_KEY=sk-your-key-here

# Optional: model override (default: claude-sonnet-5-20250611)
# ANTHROPIC_MODEL=claude-sonnet-5-20250611

# Safety level: 0=ask-all, 1=auto-read, 2=auto-file, 3=autonomous
# SAFETY_LEVEL=1

# Guardrails: a policy layer that blocks tool calls escaping the working
# directory and dangerous shell commands before they run, and caps oversized
# tool results afterward. Applies to the main agent and sub-agents alike.
# (default: enabled)
# GUARDRAILS_ENABLED=1

# Maximum length (in chars) of a single tool result before it is truncated.
# 0 disables truncation. (default: 20000)
# MAX_TOOL_RESULT_CHARS=20000

# Anthropic prompt caching: marks the system prompt and tool definitions with
# ephemeral cache_control breakpoints so unchanged prefixes are reused across
# turns (5-minute TTL; prefixes under ~1024 tokens are not cached). Applies to
# the main agent, sub-agents, and summarizer alike. (default: enabled)
# PROMPT_CACHING_ENABLED=1

# Cost ceiling (USD) for the estimated token spend of a conversation. When the
# estimated spend reaches this amount the agent stops the current turn. 0
# disables the cap. (default: 0)
# MAX_COST_USD=0

# Maximum number of tool calls the agent runs concurrently in a single turn.
# When the model returns several independent tool_use blocks they dispatch in
# parallel up to this cap, then the results are recorded in block order. 1
# forces sequential execution. (default: 5)
# MAX_PARALLEL_TOOL_CALLS=5

# Interactive tool approvals: before destructive tool calls (delete/move/
# shell/subagent) and before overwriting an existing file, the CLI pauses and
# asks y/n/auto — "y" allows the call, "n" denies it, "a" auto-approves the
# rest of the turn. Denials are fed back to the agent so it can adapt. 0
# disables the prompts (risky calls run without asking). (default: enabled)
# TOOL_APPROVALS_ENABLED=1

# Working directory for the agent (default: current dir)
# AGENT_WORK_DIR=.

# Shared SQLite database for tasks, sessions, and the file index
# (default: ~/.taskflow/taskflow.db)
# TASKFLOW_DB=~/.taskflow/taskflow.db

# Semantic memory: once a conversation's estimated token count passes this
# threshold, the older turns are condensed into a rolling summary that is
# injected back into the model's context and persisted per session.
# 0 disables summarization. (default: 60000)
# MEMORY_SUMMARY_THRESHOLD=60000

# Cross-session memory: how many of the newest durable facts to inject into
# the model's system context each turn. Facts persist in the shared SQLite
# database across sessions and are managed via the /remember, /recall, and
# /forget commands (or the agent's own remember/recall tools). 0 disables
# injection. (default: 5)
# MEMORY_INJECT_FACTS=5

# External MCP servers whose tools the agent may call (JSON object mapping
# server name -> launch details). Each entry needs a "command"; "args", "env",
# and "cwd" are optional. At startup every server is queried for its tool list
# and those tools become first-class agent tools.
# MCP_SERVERS={"filesystem": {"command": "npx", "args": ["-y",
#   "@modelcontextprotocol/server-filesystem", "/tmp"]}}
